 "phrases": [
  {
   "text": "\u0422\u044b \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u0437\u043d\u0430\u0435\u0448\u044c \u043e\u0431 \u044d\u0442\u043e\u043c \u043c\u0438\u0440\u0435 \u0432\u0441\u0451?",
   "s": 0.0,
   "e": 2.142
  },
  {
   "text": "\u0422\u043e\u0433\u0434\u0430 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u044d\u0442\u0438 \u043f\u044f\u0442\u044c \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432!",
   "s": 2.595,
   "e": 5.98
  },
  {
   "text": "\u0424\u0430\u043a\u0442 \u043d\u043e\u043c\u0435\u0440 \u043e\u0434\u0438\u043d!",
   "s": 6.539,
   "e": 7.699
  },
  {
   "text": "\u0423 \u043e\u0441\u044c\u043c\u0438\u043d\u043e\u0433\u0430 \u0442\u0440\u0438 \u0441\u0435\u0440\u0434\u0446\u0430!",
   "s": 8.0,
   "e": 9.787
  },
  {
   "text": "\u0414\u0432\u0430 \u043f\u0435\u0440\u0435\u043a\u0430\u0447\u0438\u0432\u0430\u044e\u0442 \u043a\u0440\u043e\u0432\u044c \u0447\u0435\u0440\u0435\u0437 \u0436\u0430\u0431\u0440\u044b,",
   "s": 10.103,
   "e": 12.124
  },
  {
   "text": "\u0430 \u0442\u0440\u0435\u0442\u044c\u0435 \u2014 \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u0442\u0435\u043b\u0443.",
   "s": 12.26,
   "e": 13.895
  },
  {
   "text": "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c, \u0435\u0441\u043b\u0438 \u0431\u044b \u0443 \u0442\u0435\u0431\u044f \u0431\u044b\u043b\u043e \u0442\u0440\u0438 \u0441\u0435\u0440\u0434\u0446\u0430!",
   "s": 14.171,
   "e": 16.672
  },
  {
   "text": "\u0424\u0430\u043a\u0442 \u043d\u043e\u043c\u0435\u0440 \u0434\u0432\u0430!",
   "s": 17.06,
   "e": 18.22
  },
  {
   "text": "\u0421\u0432\u0435\u0442 \u043e\u0442 \u0421\u043e\u043b\u043d\u0446\u0430 \u043b\u0435\u0442\u0438\u0442 \u0434\u043e \u0417\u0435\u043c\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0432\u043e\u0441\u0435\u043c\u044c \u043c\u0438\u043d\u0443\u0442 \u0438 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c \u0441\u0435\u043a\u0443\u043d\u0434.",
   "s": 18.513,
   "e": 22.606
  },
  {
   "text": "\u0422\u043e \u0435\u0441\u0442\u044c \u043c\u044b \u0432\u0438\u0434\u0438\u043c \u0421\u043e\u043b\u043d\u0446\u0435 \u043d\u0435 \u0442\u0430\u043a\u0438\u043c, \u043a\u0430\u043a\u043e\u0435 \u043e\u043d\u043e \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441,",
   "s": 22.827,
   "e": 25.688
  },
  {
   "text": "\u0430 \u043a\u0430\u043a\u0438\u043c \u043e\u043d\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0438\u043d\u0443\u0442 \u043d\u0430\u0437\u0430\u0434!",
   "s": 25.861,
   "e": 28.183
  },
  {
   "text": "\u0424\u0430\u043a\u0442 \u043d\u043e\u043c\u0435\u0440 \u0442\u0440\u0438!",
   "s": 28.535,
   "e": 29.675
  },
  {
   "text": "\u0410\u043a\u0443\u043b\u044b \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0440\u0430\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u043f\u0435\u0440\u0432\u044b\u0435 \u0434\u0435\u0440\u0435\u0432\u044c\u044f!",
   "s": 29.939,
   "e": 32.742
  },
  {
   "text": "\u0410\u043a\u0443\u043b\u044b \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u0443\u0436\u0435 \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u0441\u043e\u0442 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043b\u0435\u0442!",
   "s": 32.983,
   "e": 36.418
  },
  {
   "text": "\u0424\u0430\u043a\u0442 \u043d\u043e\u043c\u0435\u0440 \u0447\u0435\u0442\u044b\u0440\u0435!",
   "s": 36.771,
   "e": 38.082
  },
  {
   "text": "\u0411\u0430\u043d\u0430\u043d\u044b \u0441 \u0431\u043e\u0442\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0441\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u044f\u0433\u043e\u0434\u0430\u043c\u0438!",
   "s": 38.332,
   "e": 41.597
  },
  {
   "text": "\u0410 \u0432\u043e\u0442 \u043a\u043b\u0443\u0431\u043d\u0438\u043a\u0430 \u2014 \u043d\u0435\u0442!",
   "s": 41.795,
   "e": 43.178
  },
  {
   "text": "\u0414\u0430,",
   "s": 43.511,
   "e": 43.895
  },
  {
   "text": "\u043f\u0440\u0438\u0440\u043e\u0434\u0430 \u044f\u0432\u043d\u043e \u043b\u044e\u0431\u0438\u0442 \u0448\u0443\u0442\u0438\u0442\u044c.",
   "s": 44.079,
   "e": 45.647
  },
  {
   "text": "\u0424\u0430\u043a\u0442 \u043d\u043e\u043c\u0435\u0440 \u043f\u044f\u0442\u044c!",
   "s": 46.056,
   "e": 47.248
  },
  {
   "text": "\u041d\u0430 \u041d\u0435\u043f\u0442\u0443\u043d\u0435 \u0438 \u0423\u0440\u0430\u043d\u0435, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043d\u0430\u0443\u0447\u043d\u044b\u043c \u043c\u043e\u0434\u0435\u043b\u044f\u043c,",
   "s": 47.491,
   "e": 50.171
  },
  {
   "text": "\u043c\u043e\u0433\u0443\u0442 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u0430\u043b\u043c\u0430\u0437\u043d\u044b\u0435 \u043e\u0441\u0430\u0434\u043a\u0438!",
   "s": 50.309,
   "e": 52.919
  },
  {
   "text": "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0448\u044c \u0434\u043e\u0436\u0434\u044c \u0438\u0437 \u0430\u043b\u043c\u0430\u0437\u043e\u0432?",
   "s": 53.126,
   "e": 55.241
  },
  {
   "text": "\u0418 \u0431\u043e\u043d\u0443\u0441 \u043e\u0442 \u043c\u0435\u043d\u044f!",
   "s": 55.568,
   "e": 56.59
  },
  {
   "text": "\u0423 \u0436\u0438\u0440\u0430\u0444\u0430 \u0432 \u0448\u0435\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0435 \u043f\u043e\u0437\u0432\u043e\u043d\u043a\u043e\u0432,",
   "s": 56.868,
   "e": 60.669
  },
  {
   "text": "\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443 \u0442\u0435\u0431\u044f \u2014 \u0432\u0441\u0435\u0433\u043e \u0441\u0435\u043c\u044c. \u041f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u043b\u0438\u043d\u043e\u0439 \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u043f\u044f\u0442\u0438 \u0441\u0430\u043d\u0442\u0438\u043c\u0435\u0442\u0440\u043e\u0432!",
   "s": 60.896,
   "e": 64.399
  },
  {
   "text": "\u041d\u0443 \u0447\u0442\u043e,",
   "s": 64.774,
   "e": 65.186
  },
  {
   "text": "\u043a\u0430\u043a\u043e\u0439 \u0444\u0430\u043a\u0442 \u0443\u0434\u0438\u0432\u0438\u043b \u0442\u0435\u0431\u044f \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0441\u0435\u0433\u043e?",
   "s": 65.431,
   "e": 67.378
  },
  {
   "text": "\u041d\u0430\u043f\u0438\u0448\u0438 \u0432 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u044f\u0445!",
   "s": 67.605,
   "e": 68.618
  },
  {
   "text": "\u0410 \u0432\u0435\u0434\u044c \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0430\u043b\u043e\u2026",
